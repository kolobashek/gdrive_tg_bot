# ─── Telegram ──────────────────────────────────────────────────────────────────
# Получить у @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# ID канала куда публиковать файлы (напр. @mychannel или -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel

# Разрешённые Telegram user ID (через запятую). Оставьте пустым = доступ для всех.
ALLOWED_USER_IDS=123456789,987654321

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Из Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Для desktop-приложения используйте OOB (copy-paste код):
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# ─── Синхронизация ──────────────────────────────────────────────────────────────
# Интервал проверки Drive в секундах (300 = 5 минут)
SYNC_INTERVAL_SECONDS=300

# ID папки Drive для наблюдения ('root' = вся Drive)
SYNC_WATCH_FOLDER_ID=root
